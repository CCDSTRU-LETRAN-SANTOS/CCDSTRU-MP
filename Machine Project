/* Preprocessor Directives */
#include <stdio.h>
#include <string.h>

/* Definitions */
#define MAX_SUBS 9
typedef struct{
    int x;
    int y;
} Coordinate;

/* Function Prototypes */
void Remove(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int go);
void Replace(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int *go, int *found);
void Expand(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int go, int *found);
void Update(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int go, int *found, int *good);
void NextPlayerMove(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int *go, int *good, int *start, int *val, int *over, int *found);
void GameOver(Coordinate R[], Coordinate B[], char result[]);

/* Helper Functions */
// check if equal
int equal(Coordinate a, Coordinate b) {
    return (a.x == b.x && a.y == b.y);
}
// check boundaries
int valid(Coordinate p) {
    return (p.x >= 1 && p.x <= 3 && p.y >= 1 && p.y <= 3);
}
// count cardinlity of set
int cardinality(Coordinate p[MAX_SUBS]){
    int size = 0;
    for(int i=0; i<MAX_SUBS; i++) {
        if(p[i].x != 0 && p[i].y != 0)
            size++;
    }
    return size;
}

/* Function Implementations */
void Remove(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int go){
    for(int i=0; i<MAX_SUBS; i++){
        // go → (R = R − {pos})
        if(go){ 
            if(equal(R[i], pos)){
                R[i].x = 0;
                R[i].y = 0;
            }
        }
        // ¬go → (B = B − {pos})
        else {
            if(equal(B[i], pos)){
                B[i].x = 0;
                B[i].y = 0;
            }
        }
        // S = S − {pos}
        if(equal(S[i], pos)){
            S[i].x = 0;
            S[i].y = 0;
        }
        // T = T − {pos}
        if(equal(T[i], pos)){
            T[i].x = 0;
            T[i].y = 0;
        }
    }
}

void Replace(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int *go, int *found){
    //found = false
    *found = 0;

    if(*go){
        int EqualR = 0;

        for(int i=0; i<MAX_SUBS; i++){
            // (go ∧ pos ∈ B) → (B = B − {pos} ∧ found = true)
            if(equal(B[i], pos)){
                B[i].x = 0;
                B[i].y = 0;
                *found = 1;
            }
            // (go ∧ pos ∈ R) → found = true
            if(equal(R[i], pos)){
                *found = 1;
                EqualR = 1;
            }
        }

        // (go ∧ pos ̸∈ R) → (R = R ∪ {pos})
        if(!EqualR){
            for(int i=0; i<MAX_SUBS; i++){
                if(R[i].x == 0 && R[i].y == 0){
                    R[i] = pos;
                    i=MAX_SUBS;
                }
            }
        }
    }
    else {
        int EqualB = 0;

        for(int i=0; i<MAX_SUBS; i++){
            // (¬go ∧ pos ∈ R) → (R = R − {pos} ∧ found = true)
            if(equal(R[i], pos)){
                R[i].x = 0;
                R[i].y = 0;
                *found = 1;
            }
            // (¬go ∧ pos ∈ B) → found = true
            if(equal(B[i], pos)){
                *found = 1;
                EqualB = 1;
            }
        }

        // (¬go ∧ pos ̸∈ B) → (B = B ∪ {pos})
        if(!EqualB){
            for(int i=0; i<MAX_SUBS; i++){
                if(B[i].x == 0 && B[i].y == 0){
                    B[i] = pos;
                    i=MAX_SUBS;
                }
            }
        }
    }

    // (found ∧ pos ̸∈ S) → (S = S ∪ {pos} ∧ found = false)
    if (*found){
        int EqualS = 0;

        // check if pos is equal to S
        for(int i=0; i<MAX_SUBS; i++){
            if(equal(S[i], pos))
                    EqualS = 1;
        }
        if(!EqualS){
            for(int i=0; i<MAX_SUBS; i++){
                if(S[i].x == 0 && S[i].y == 0){
                    S[i] = pos;
                    *found = 0;
                    i=MAX_SUBS;
                }
            }
        }
        //(found ∧ pos ∈ S ∧ pos ̸∈ T) → (T = T ∪ {pos} ∧ Expand(pos))
        else {
            int EqualT = 0;

            // check if pos is equal to T
            for(int i=0; i<MAX_SUBS; i++){
                if(equal(T[i], pos))
                    EqualT = 1;
            }
            if(!EqualT){
                for(int i=0; i<MAX_SUBS; i++){
                    if(T[i].x == 0 && T[i].y == 0){
                        T[i] = pos;
                        Expand(pos, R, B, S, T, *go, found);
                        i=MAX_SUBS;
                    }
                }
            }
        }
    }
}

void Expand(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int go, int *found){
    // (a, b) = pos
    int a, b;
    a = pos.x;
    b = pos.y;

    // u, d, k, r ∈ M
    Coordinate u, d, k, r;

    // u = (a − 1, b)
    u.x = a-1;
    u.y = b;

    // d = (a + 1, b)
    d.x = a+1;
    d.y = b;

    // k = (a, b − 1)
    k.x = a;
    k.y = b-1;

    // r = (a, b + 1)
    r.x = a;
    r.y = b+1;

    //Remove(pos)
    Remove(pos, R, B, S, T, go);

    // (go) → Replace(u)
    if(go) {
        if(valid(u))
            Replace(u, R, B, S, T, &go, found);
    }
    // (¬go) → Replace(d)
    else {
        if(valid(d))
            Replace(d, R, B, S, T, &go, found);
    }

    //Replace(k)
    if(valid(k))
        Replace(k, R, B, S, T, &go, found);

    //Replace(r)
    if(valid(r))
        Replace(r, R, B, S, T, &go, found);
}

void Update(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[], int go, int *found, int *good){
    // good = false
    *good = 0;

    // (pos ̸∈ S) → (S = S ∪ {pos} ∧ good = ¬good)
    int EqualS = 0;
    // check if pos is equal to S
    for(int i=0; i<MAX_SUBS; i++){
        if(equal(S[i], pos))
            EqualS = 1;
    }
    if(!EqualS){
        for(int i=0; i<MAX_SUBS; i++){
            if(S[i].x == 0 && S[i].y == 0){
                S[i] = pos;
                *good = 1;
                i=MAX_SUBS;
            }
        }
    }

    // (¬good ∧ pos ∈ S ∧ pos ̸∈ T) → (T = T ∪ {pos} ∧ Expand(pos))
    int EqualT = 0;
    // check if pos is equal to T
    for(int i=0; i<MAX_SUBS; i++){
        if(equal(T[i], pos))
            EqualT = 1;
    }
    if(!(*good) && EqualS && !EqualT) {
        for(int i=0; i<MAX_SUBS; i++){
            if(T[i].x == 0 && T[i].y == 0){
                T[i] = pos;
                Expand(pos, R, B, S, T, go, found);
                i=MAX_SUBS;
            }
        }
    }
}

void NextPlayerMove(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[],
                        int *go, int *good, int *start, int *val, int *over, int *found){
    if(!(*over)) {
        if(*start) {
            // (¬over ∧ start ∧ go) → (R = R ∪ {pos} ∧ S = S ∪ {pos} ∧ good = true)
            if(*go) {
                for(int i=0; i<MAX_SUBS; i++) {
                    if(R[i].x == 0 && R[i].y == 0) {
                        R[i] = pos;
                        i=MAX_SUBS;
                    }
                }
            }
            // (¬over ∧ start ∧ ¬go) → (B = B ∪ {pos} ∧ S = S ∪ {pos} ∧ good = true)
            else {
                for(int i=0; i<MAX_SUBS; i++) {
                    if(B[i].x == 0 && B[i].y == 0) {
                        B[i] = pos;
                        i=MAX_SUBS;
                    }
                }    
            }

            for(int i=0; i<MAX_SUBS; i++) {
                if(S[i].x == 0 && S[i].y == 0) {
                        S[i] = pos;
                        i=MAX_SUBS;
                }     
            }

            *good = 1;
        }
        // (¬over ∧ ¬start ∧ (go ∧ pos ∈ R ∨ ¬go ∧ pos ∈ B)) → (Update(pos) ∧ good = true)
        else{
            for(int i=0; i<MAX_SUBS; i++) {
                if((*go && equal(R[i], pos)) || (!(*go) && equal(B[i], pos))) {
                    Update(pos, R, B, S, T, *go, found, good);
                    *good = 1;
                }
            }
        }
        // (¬over ∧ good) → (good = ¬good ∧ go = ¬go ∧ val = val + 1)
        if(*good) {
            *good = 0;
            *go = !(*go);
            *val += 1;
        }
        else
            printf("Invalid Move, Try Again\n");
    }

    // (start ∧ |R| = 1 ∧ |B| = 1) → start = false
    if(*start){
        int countR, countB;
    
        countR = cardinality(R);
        countB = cardinality(B);

        if(countR == 1 && countB == 1)
            *start = 0;
    }
}

void GameOver(Coordinate R[], Coordinate B[], char result[]){
    // result ∈ {“R wins”, “B wins”, “draw”}
    int countR, countB;

    countR = cardinality(R);
    countB = cardinality(B);

    // (over ∧ |R| > |B|) → result = “R wins”
    if(countR > countB) 
        strcpy(result, "R wins");
    // (over ∧ |R| < |B|) → result = “B wins”
    else if(countR < countB) 
        strcpy(result, "B wins");
    // (over ∧ |R| = |B|) → result = “draw”
    else
        strcpy(result, "draw");
           
}

void PrintBoard(Coordinate R[], Coordinate B[]) {
    char M[3][3];

    printf("Board:\n\n");

    // initialize
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            M[i][j] = 'x';
        }
    }

    // place R
    for(int i = 0; i < MAX_SUBS; i++) {
        if(R[i].x != 0 && R[i].y != 0) {
            M[R[i].x - 1][R[i].y - 1] = 'R';
        }
    }

    // place B
    for(int i = 0; i < MAX_SUBS; i++) {
        if(B[i].x != 0 && B[i].y != 0) {
            M[B[i].x - 1][B[i].y - 1] = 'B';
        }
    }

    // print board
    for(int i = 0; i < 3; i++) {
        for(int j = 0; j < 3; j++) {
            printf(" %c ", M[i][j]);
        }
        printf("\n");
    }
    printf("\n");
}

int main(){
    /* Variable Implementation */
    int val, good, go, start, over, found, sizeR, sizeB, sizeF, intersection;
    Coordinate R[MAX_SUBS], B[MAX_SUBS], S[MAX_SUBS], T[MAX_SUBS], pos;
    char result[7];

    /* Variable Initialization */
    good = 0; //false
    go = 1; //true
    start = 1; //true
    found = 0; //false
    over = 0; //false
    val = 0;
    sizeR = 0;
    sizeB = 0; 
    sizeF = 0;
    // R, B, S, T = ∅
    for(int i=0; i<MAX_SUBS; i++){
        R[i] = (Coordinate){0,0};
        B[i] = (Coordinate){0,0};
        S[i] = (Coordinate){0,0};
        T[i] = (Coordinate){0,0};
    }

    printf("Welcome to the Game!\n\n");
    while(!over){
        PrintBoard(R, B);
        if(go){
            printf("Player R, Choose a Position\n");
        }
        else if (!go){
            printf("Player B, Choose a Position\n");
        }
        printf("X-Coordinate: ");
        scanf("%d", &pos.x);
        printf("Y-Coordinate: ");
        scanf("%d", &pos.y);
        printf("\n");

        if(valid(pos)){
            NextPlayerMove(pos, R, B, S, T, &go, &good, &start, &val, &over, &found);

            sizeR = cardinality(R);
            sizeB = cardinality(B);
            //find intersection
            intersection = 0;
            for(int i=0; i<MAX_SUBS; i++){
                for(int j=0; j<MAX_SUBS; j++){
                    if(equal(R[i], B[j]) && R[i].x != 0 && R[i].y != 0)
                        intersection++;
                }
            }
        }
            }
            // M minus union of R and B
            sizeF = MAX_SUBS - ((sizeR+sizeB)-intersection);

            //check conditions to end game
            if(sizeF==3 || val>=20 || (!start && ((sizeR>0 && sizeB==0) || (sizeR==0 && sizeB>0))))
                over = 1;
        }
        else
            printf("Enter a Valid Coordinate\n");
    }
    GameOver(R, B, result);
    printf("%s\n", result);

    return 0;
}
