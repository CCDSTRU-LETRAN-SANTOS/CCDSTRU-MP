/* Preprocessor Directives */
#include <stdio.h>

/* Definitions */
#define MAX_SUBS 9
typedef struct{
    int x;
    int y;
} Coordinate;


/* Notes: */
// M is the Board (3x3)
// R and B is the players
// go = player R's turn
// ¬go = player B's turn
// pos is a coordinate on M
// RBST is an array of all possible coordinates on board (?)

/* Conditions */
// over ↔ (|F| = 3 ∨ val ≥ 20 ∨ ¬start ∧ (|R| > 0 ∧ |B| = 0 ∨ |R| = 0 ∧ |B| > 0))
// val = N where N : {x ∈ Z+ ∪ {0} | x <= 16}
// R, B, S, T, F ⊆ M where M : C × C (C : {x ∈ Z+ | x < 4})
// good, go, start, over, found = V where V: {true, false}
// F = M−(R ∪ B)

// C = 1, 2, 3
// N = 0-16
// M = 9 subsets (3x3) = {(1,1), (1,2), (1,3), (2,1), (2,2), (2,3), (3,1), (3,2), (3,3)}

/* Function Prototypes */
void Remove(Coordinate pos);
void Replace(Coordinate pos);
void Expand(Coordinate pos);

/* Function Implementations */
void Remove(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[]){
    // go → (R = R − {pos})
    if(go==0){
        for(int i=0; i<MAX_SUBS; i++){
            if(R[i].x == pos.x && R[i].y == pos.y){
                R[i].x = 0;
                R[i].y = 0;
            }
        }
    }
    // ¬go → (B = B − {pos})
    else if(go==1){
        for(int i=0; i<MAX_SUBS; i++){
            if(B[i].x == pos.x && B[i].y == pos.y){
                B[i].x = 0;
                B[i].y = 0;
            }
        }
    }
    for(int i=0; i<MAX_SUBS; i++){
            // S = S − {pos}
            if(S[i].x == pos.x && S[i].y == pos.y){
                S[i].x = 0;
                S[i].y = 0;
            }
            // T = T − {pos}
            if(T[i].x == pos.x && T[i].y == pos.y){
                T[i].x = 0;
                T[i].y = 0;
            }
    }
}

void Replace(Coordinate pos, Coordinate R[], Coordinate B[], Coordinate S[], Coordinate T[]){
    //found = false
    found = 0;
    if(go==0){
        // (go ∧ pos ∈ B) → (B = B − {pos} ∧ found = true)
        for(int i=0; i<MAX_SUBS; i++){
            if(pos.x == B[i].x && pos.y == B[i].y){
                B[i].x = 0;
                B[i].y = 0;
                found = 1;
            }
        }
        int EqualR = 0;
        // (go ∧ pos ∈ R) → found = true
        for(int i=0; i<MAX_SUBS; i++){
            if(pos.x == R[i].x && pos.y == R[i].y){
                found = 1;
                EqualR = 1;
            }
        }
        // (go ∧ pos ̸∈ R) → (R = R ∪ {pos})
        if(EqualR == 0){
            for(int i=0; i<MAX_SUBS; i++){
                if(R[i].x == 0 && R[i].y == 0){
                    R[i].x = pos.x;
                    R[i].y = pos.y;
                    i=MAX_SUBS;
                }
            }
        }
    }
    if(go==1){
        // (¬go ∧ pos ∈ R) → (R = R − {pos} ∧ found = true)
        for(int i=0; i<MAX_SUBS; i++){
            if(pos.x == R[i].x && pos.y == R[i].y){
                R[i].x = 0;
                R[i].y = 0;
                found = 1;
            }
        }
        int EqualB = 0;
        // (¬go ∧ pos ∈ B) → found = true
        for(int i=0; i<MAX_SUBS; i++){
            if(pos.x == B[i].x && pos.y == B[i].y){
                found = 1;
                EqualB = 1;
            }
        }
        // (¬go ∧ pos ̸∈ B) → (B = B ∪ {pos})
        if(EqualB == 0){
            for(int i=0; i<MAX_SUBS; i++){
                if(B[i].x == 0 && B[i].y == 0){
                    B[i].x = pos.x;
                    B[i].y = pos.y;
                    i=MAX_SUBS;
                }
            }
        }
    }
    // (found ∧ pos ̸∈ S) → (S = S ∪ {pos} ∧ found = false)
    if (found==1){
        int EqualS = 0;
        // check if pos is equal to S
        for(int i=0; i<MAX_SUBS; i++){
            if(S[i].x == pos.x && S[i].y == pos.y){
                    EqualS = 1;
            }
        }
        if(EqualS == 0){
            for(int i=0; i<MAX_SUBS; i++){
                if(S[i].x == 0 && S[i].y == 0){
                    S[i].x = pos.x;
                    S[i].y = pos.y;
                    found = 0;
                    i=MAX_SUBS;
                }
            }
        }
        //(found ∧ pos ∈ S ∧ pos ̸∈ T) → (T = T ∪ {pos} ∧ Expand(pos))
        if (EqualS == 1){
            int EqualT = 0;
            // check if pos is equal to T
            for(int i=0; i<MAX_SUBS; i++){
                if(T[i].x == pos.x && T[i].y == pos.y){
                    EqualT = 1;
                }
            }
            if(EqualT == 0){
                for(int i=0; i<MAX_SUBS; i++){
                    if(T[i].x == 0 && T[i].y == 0){
                        T[i].x = pos.x;
                        T[i].y = pos.y;
                        Expand(pos);
                        i=MAX_SUBS;
                    }
                }
            }
        }
    }
}

void Expand(Coordinate pos){
    // (a, b) = pos
    int a, b;
    a = pos.x;
    b = pos.y;
    // u, d, k, r ∈ M
    Coordinate u, d, k, r;
    // u = (a − 1, b)
    u.x = a-1;
    u.y = b;
    // d = (a + 1, b)
    d.x = a+1;
    d.y = b;
    // k = (a, b − 1)
    k.x = a;
    k.y = b-1;
    // r = (a, b + 1)
    r.x = a;
    r.y = b+1;
    //Remove(pos)
    Remove(pos);
    // (go) → Replace(u)
    if(go){
        Replace(u);
    }
    // (¬go) → Replace(d)
    if(!go){
        Replace(d);
    }
    //Replace(k)
    Replace(k);
    //Replace(r)
    Replace(r);
}

